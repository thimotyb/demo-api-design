              "protocol": "http",
              "host": [
                "127.0.0.1"
              ],
              "port": "4010",
              "path": [
                "orders",
                "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"status matches the scenario\", function () {",
                  "  pm.expect(body[\"status\"]).to.eql(\"SHIPPED\");",
                  "});",
                  "pm.test(\"trackingCode matches the scenario\", function () {",
                  "  pm.expect(body[\"trackingCode\"]).to.eql(\"DEMO-TRACK-001\");",
