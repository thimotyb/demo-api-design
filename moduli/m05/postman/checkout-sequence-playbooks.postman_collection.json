        {
          "name": "01 - GET /orders/{orderId} [200 orderWithShipment]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "code=200, example=orderWithShipment, dynamic=false"
              }
            ],
            "url": {
