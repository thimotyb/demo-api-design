{
  "openapi": "3.1.0",
  "info": {
    "title": "M3 Orders API Demo",
    "version": "1.0.0",
    "description": "OpenAPI snapshot for the M3 protected FastAPI Orders API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "get_root",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "List Orders",
        "operationId": "list_orders",
        "security": [
          {
            "OAuth2ClientCredentials": []
          }
        ],
        "responses": {
          "200": {
            "description": "Order summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSummary"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create Order",
        "operationId": "create_order",
        "security": [
          {
            "OAuth2ClientCredentials": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Get Order",
        "operationId": "get_order",
        "security": [
          {
            "OAuth2ClientCredentials": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/orders/{order_id}/lines": {
      "get": {
        "summary": "List Order Lines",
        "operationId": "list_order_lines",
        "security": [
          {
            "OAuth2ClientCredentials": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order lines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderLine"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "Client credentials flow of the Keycloak realm m3-jwt",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "http://localhost:8080/realms/m3-jwt/protocol/openid-connect/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token"
      },
      "NotFound": {
        "description": "Requested order not found"
      },
      "Forbidden": {
        "description": "Valid token without the required role (orders:read or orders:write)"
      }
    },
    "schemas": {
      "RootResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "OrderLineBase": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        },
        "required": [
          "sku",
          "description",
          "quantity",
          "unit_price"
        ],
        "additionalProperties": false
      },
      "OrderLine": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderLineBase"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "OrderCreate": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "string",
            "minLength": 1
          },
          "order_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "default": "new"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLineBase"
            },
            "default": []
          }
        },
        "required": [
          "customer"
        ],
        "additionalProperties": false
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer": {
            "type": "string"
          },
          "order_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "line_count": {
            "type": "integer"
          },
          "total_amount": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "id",
          "customer",
          "order_date",
          "status",
          "line_count",
          "total_amount"
        ],
        "additionalProperties": false
      },
      "OrderDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderSummary"
          },
          {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderLine"
                }
              }
            },
            "required": [
              "lines"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
